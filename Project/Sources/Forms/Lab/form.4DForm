{
	"$4d": {
		"version": "1",
		"kind": "form"
	},
	"windowSizingX": "fixed",
	"windowSizingY": "fixed",
	"windowMinWidth": 1160,
	"windowMinHeight": 856,
	"windowMaxWidth": 1160,
	"windowMaxHeight": 856,
	"rightMargin": 20,
	"bottomMargin": 20,
	"events": [
		"onLoad",
		"onUnload"
	],
	"windowTitle": "DateTime Lab",
	"destination": "detailScreen",
	"method": "method.4dm",
	"formClass": "TimeLab",
	"pages": [
		{
			"objects": {}
		},
		{
			"objects": {
				"headerBg": {
					"type": "rectangle",
					"left": 0,
					"top": 0,
					"width": 1160,
					"height": 78,
					"class": "header",
					"stroke": "transparent",
					"borderStyle": "none"
				},
				"lblApp": {
					"type": "text",
					"text": "DateTime Lab",
					"left": 24,
					"top": 16,
					"width": 520,
					"height": 34,
					"fontSize": 24,
					"fontWeight": "bold",
					"class": "headerText"
				},
				"lblTagline": {
					"type": "text",
					"text": "Instants \u2192 exact IANA zones through the miyako/DateTime 4D component",
					"left": 24,
					"top": 50,
					"width": 680,
					"height": 18,
					"class": "headerText",
					"fontSize": 11
				},
				"inpComponent": {
					"type": "input",
					"dataSource": "Form.componentLine",
					"left": 700,
					"top": 18,
					"width": 436,
					"height": 20,
					"dataSourceTypeHint": "text",
					"enterable": false,
					"hideFocusRing": true,
					"borderStyle": "none",
					"fill": "transparent",
					"class": "dim mono",
					"fontSize": 11,
					"textAlign": "right"
				},
				"inpEnv": {
					"type": "input",
					"dataSource": "Form.envDetail",
					"left": 700,
					"top": 42,
					"width": 436,
					"height": 20,
					"dataSourceTypeHint": "text",
					"enterable": false,
					"hideFocusRing": true,
					"borderStyle": "none",
					"fill": "transparent",
					"class": "dim mono",
					"fontSize": 11,
					"textAlign": "right"
				},
				"headerRule": {
					"type": "line",
					"left": 20,
					"top": 78,
					"width": 1120,
					"height": 1,
					"stroke": "automatic"
				},
				"grpSingle": {
					"type": "groupBox",
					"text": "1 \u00b7 Convert one instant",
					"left": 20,
					"top": 92,
					"width": 548,
					"height": 376
				},
				"lblInstant": {
					"type": "text",
					"text": "Instant \u2014 RFC3339, uppercase T/Z, explicit offset",
					"left": 38,
					"top": 120,
					"width": 512,
					"height": 16,
					"class": "dim",
					"fontSize": 11
				},
				"inpInstant": {
					"type": "input",
					"dataSource": "Form.instant",
					"dataSourceTypeHint": "text",
					"left": 38,
					"top": 138,
					"width": 512,
					"height": 26,
					"class": "mono"
				},
				"lblZone": {
					"type": "text",
					"text": "IANA zone \u2014 exact and case-sensitive",
					"left": 38,
					"top": 174,
					"width": 300,
					"height": 16,
					"class": "dim",
					"fontSize": 11
				},
				"inpZone": {
					"type": "input",
					"dataSource": "Form.zone",
					"dataSourceTypeHint": "text",
					"left": 38,
					"top": 192,
					"width": 316,
					"height": 26,
					"class": "mono"
				},
				"popZone": {
					"type": "dropdown",
					"dataSource": "Form.zonePicker",
					"dataSourceTypeHint": "object",
					"left": 362,
					"top": 192,
					"width": 188,
					"height": 26,
					"events": [
						"onClick"
					],
					"method": "ObjectMethods/popZone.4dm"
				},
				"btnConvert": {
					"type": "button",
					"text": "Convert \u2192",
					"left": 38,
					"top": 228,
					"width": 132,
					"height": 28,
					"events": [
						"onClick"
					],
					"method": "ObjectMethods/btnConvert.4dm",
					"tooltip": "Run cs.DateTime.DateTime.convert(instant; zone)",
					"defaultButton": true
				},
				"btnCopy": {
					"type": "button",
					"text": "Copy JSON",
					"left": 178,
					"top": 228,
					"width": 132,
					"height": 28,
					"events": [
						"onClick"
					],
					"method": "ObjectMethods/btnCopy.4dm",
					"tooltip": "Copy the last raw component value"
				},
				"lblLocal": {
					"type": "text",
					"text": "Local time",
					"left": 38,
					"top": 268,
					"width": 200,
					"height": 16,
					"class": "dim",
					"fontSize": 11
				},
				"inpLocal": {
					"type": "input",
					"dataSource": "Form.local",
					"left": 38,
					"top": 286,
					"width": 512,
					"height": 32,
					"dataSourceTypeHint": "text",
					"enterable": false,
					"hideFocusRing": true,
					"borderStyle": "none",
					"fill": "transparent",
					"class": "mono",
					"fontSize": 20,
					"fontWeight": "bold"
				},
				"lblOffset": {
					"type": "text",
					"text": "Offset from UTC",
					"left": 38,
					"top": 324,
					"width": 150,
					"height": 16,
					"class": "dim",
					"fontSize": 11
				},
				"inpOffset": {
					"type": "input",
					"dataSource": "Form.offsetText",
					"left": 38,
					"top": 342,
					"width": 240,
					"height": 20,
					"dataSourceTypeHint": "text",
					"enterable": false,
					"hideFocusRing": true,
					"borderStyle": "none",
					"fill": "transparent",
					"class": "mono"
				},
				"lblStatus": {
					"type": "text",
					"text": "Status",
					"left": 300,
					"top": 324,
					"width": 250,
					"height": 16,
					"class": "dim",
					"fontSize": 11
				},
				"inpStatus": {
					"type": "input",
					"dataSource": "Form.statusText",
					"left": 300,
					"top": 342,
					"width": 250,
					"height": 20,
					"dataSourceTypeHint": "text",
					"enterable": false,
					"hideFocusRing": true,
					"borderStyle": "none",
					"fill": "transparent"
				},
				"lblRaw": {
					"type": "text",
					"text": "Raw component value (JSON)",
					"left": 38,
					"top": 372,
					"width": 300,
					"height": 16,
					"class": "dim",
					"fontSize": 11
				},
				"inpRaw": {
					"type": "input",
					"dataSource": "Form.raw",
					"left": 38,
					"top": 390,
					"width": 512,
					"height": 46,
					"dataSourceTypeHint": "text",
					"enterable": false,
					"hideFocusRing": true,
					"borderStyle": "none",
					"fill": "transparent",
					"class": "mono",
					"fontSize": 10,
					"multiline": "yes",
					"wordwrap": "normal"
				},
				"inpDetail": {
					"type": "input",
					"dataSource": "Form.statusDetail",
					"left": 38,
					"top": 444,
					"width": 512,
					"height": 18,
					"dataSourceTypeHint": "text",
					"enterable": false,
					"hideFocusRing": true,
					"borderStyle": "none",
					"fill": "transparent",
					"class": "dim",
					"fontSize": 10
				},
				"grpRight": {
					"type": "groupBox",
					"text": "2 \u00b7 What the component guarantees",
					"left": 588,
					"top": 92,
					"width": 552,
					"height": 376
				},
				"txtRules": {
					"type": "input",
					"dataSource": "Form.rulesText",
					"left": 606,
					"top": 120,
					"width": 516,
					"height": 312,
					"dataSourceTypeHint": "text",
					"enterable": false,
					"hideFocusRing": true,
					"borderStyle": "none",
					"fill": "transparent",
					"fontSize": 12,
					"multiline": "yes",
					"wordwrap": "normal"
				},
				"lblRuleFoot": {
					"type": "text",
					"text": "Tricky cases at the bottom exercise these rules for real.",
					"left": 606,
					"top": 438,
					"width": 516,
					"height": 18,
					"class": "dim",
					"fontSize": 11
				},
				"grpBatch": {
					"type": "groupBox",
					"text": "3 \u00b7 Batch \u2014 ordered results, per-item errors",
					"left": 20,
					"top": 484,
					"width": 1120,
					"height": 240
				},
				"lbBatch": {
					"type": "listbox",
					"listboxType": "collection",
					"dataSource": "Form.rows",
					"left": 38,
					"top": 512,
					"width": 900,
					"height": 186,
					"rowHeight": "24px",
					"verticalAlign": "middle",
					"alternateFill": "automaticAlternate",
					"resizingMode": "legacy",
					"currentItemSource": "Form.selectedRow",
					"currentItemPositionSource": "Form.selectedRowPos",
					"events": [
						"onDoubleClick"
					],
					"method": "ObjectMethods/lbBatch.4dm",
					"columns": [
						{
							"name": "idx",
							"dataSource": "This.index",
							"width": 44,
							"truncateMode": "none",
							"header": {
								"name": "hdridx",
								"text": "#"
							},
							"minWidth": 40
						},
						{
							"name": "instant",
							"dataSource": "This.instant",
							"width": 232,
							"truncateMode": "none",
							"header": {
								"name": "hdrinstant",
								"text": "Instant"
							},
							"minWidth": 180
						},
						{
							"name": "zone",
							"dataSource": "This.zone",
							"width": 160,
							"truncateMode": "none",
							"header": {
								"name": "hdrzone",
								"text": "Zone"
							},
							"minWidth": 130
						},
						{
							"name": "status",
							"dataSource": "This.status",
							"width": 58,
							"truncateMode": "none",
							"header": {
								"name": "hdrstatus",
								"text": "Status"
							},
							"minWidth": 55
						},
						{
							"name": "local",
							"dataSource": "This.local",
							"width": 196,
							"truncateMode": "none",
							"header": {
								"name": "hdrlocal",
								"text": "Local result"
							},
							"minWidth": 150
						},
						{
							"name": "offset",
							"dataSource": "This.offset",
							"width": 76,
							"truncateMode": "none",
							"header": {
								"name": "hdroffset",
								"text": "Offset"
							},
							"minWidth": 70
						},
						{
							"name": "error",
							"dataSource": "This.error",
							"width": 134,
							"truncateMode": "none",
							"header": {
								"name": "hdrerror",
								"text": "Error"
							},
							"minWidth": 120
						}
					]
				},
				"btnRunBatch": {
					"type": "button",
					"text": "Run batch",
					"left": 956,
					"top": 512,
					"width": 152,
					"height": 26,
					"events": [
						"onClick"
					],
					"method": "ObjectMethods/btnRunBatch.4dm",
					"tooltip": "convertBatch() \u2014 one process, ordered results"
				},
				"btnLoadBatch": {
					"type": "button",
					"text": "Load demo batch",
					"left": 956,
					"top": 546,
					"width": 152,
					"height": 26,
					"events": [
						"onClick"
					],
					"method": "ObjectMethods/btnLoadBatch.4dm",
					"tooltip": "8 rows, 3 of them invalid"
				},
				"btnStress": {
					"type": "button",
					"text": "Stress: 256 rows",
					"left": 956,
					"top": 580,
					"width": 152,
					"height": 26,
					"events": [
						"onClick"
					],
					"method": "ObjectMethods/btnStress.4dm",
					"tooltip": "The transport maximum for one batch"
				},
				"btnClear": {
					"type": "button",
					"text": "Clear",
					"left": 956,
					"top": 614,
					"width": 152,
					"height": 26,
					"events": [
						"onClick"
					],
					"method": "ObjectMethods/btnClear.4dm",
					"tooltip": "Empty the batch"
				},
				"inpBatchNote": {
					"type": "input",
					"dataSource": "Form.batchNote",
					"left": 956,
					"top": 650,
					"width": 160,
					"height": 56,
					"dataSourceTypeHint": "text",
					"enterable": false,
					"hideFocusRing": true,
					"borderStyle": "none",
					"fill": "transparent",
					"class": "dim",
					"fontSize": 10,
					"multiline": "yes",
					"wordwrap": "normal"
				},
				"grpPresets": {
					"type": "groupBox",
					"text": "4 \u00b7 Tricky cases \u2014 click to load and convert",
					"left": 20,
					"top": 740,
					"width": 1120,
					"height": 96
				},
				"btnPresetDST": {
					"type": "button",
					"text": "DST +02:00",
					"left": 38,
					"top": 768,
					"width": 256,
					"height": 26,
					"events": [
						"onClick"
					],
					"method": "ObjectMethods/btnPresetDST.4dm",
					"tooltip": "Paris, 2026-03-29T01:00:00Z \u2014 offset jumps from +01:00 to +02:00"
				},
				"btnPresetMonrovia": {
					"type": "button",
					"text": "Monrovia \u221200:44:30",
					"left": 306,
					"top": 768,
					"width": 256,
					"height": 26,
					"events": [
						"onClick"
					],
					"method": "ObjectMethods/btnPresetMonrovia.4dm",
					"tooltip": "1920 \u2014 a historical offset with seconds precision"
				},
				"btnPresetKathmandu": {
					"type": "button",
					"text": "Kathmandu +05:45",
					"left": 574,
					"top": 768,
					"width": 256,
					"height": 26,
					"events": [
						"onClick"
					],
					"method": "ObjectMethods/btnPresetKathmandu.4dm",
					"tooltip": "Nepal's 45-minute offset"
				},
				"btnPresetKiritimati": {
					"type": "button",
					"text": "Kiritimati +14:00",
					"left": 842,
					"top": 768,
					"width": 256,
					"height": 26,
					"events": [
						"onClick"
					],
					"method": "ObjectMethods/btnPresetKiritimati.4dm",
					"tooltip": "Across the date line: the local date is tomorrow"
				},
				"btnPresetLowercase": {
					"type": "button",
					"text": "lowercase t/z",
					"left": 38,
					"top": 798,
					"width": 256,
					"height": 26,
					"events": [
						"onClick"
					],
					"method": "ObjectMethods/btnPresetLowercase.4dm",
					"tooltip": "Rejected: RFC3339 requires uppercase T and Z"
				},
				"btnPresetFraction": {
					"type": "button",
					"text": "4-digit fraction",
					"left": 306,
					"top": 798,
					"width": 256,
					"height": 26,
					"events": [
						"onClick"
					],
					"method": "ObjectMethods/btnPresetFraction.4dm",
					"tooltip": "Rejected: more than three fraction digits is never truncated"
				},
				"btnPresetUnknownZone": {
					"type": "button",
					"text": "unknown zone",
					"left": 574,
					"top": 798,
					"width": 256,
					"height": 26,
					"events": [
						"onClick"
					],
					"method": "ObjectMethods/btnPresetUnknownZone.4dm",
					"tooltip": "Rejected: unknown IANA zone, no GMT fallback"
				},
				"btnPresetLadder": {
					"type": "button",
					"text": "offset ladder",
					"left": 842,
					"top": 798,
					"width": 256,
					"height": 26,
					"events": [
						"onClick"
					],
					"method": "ObjectMethods/btnPresetLadder.4dm",
					"tooltip": "Batch: one instant across 30 zones, in input order"
				}
			}
		}
	]
}
